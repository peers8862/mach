{
  "uuid": "EFDD0B25-BE3A-5B1C-A849-23267A8427DF",
  "name": "NA Hub",
  "groupUUID": "74F74B68-4973-572B-A509-EBCDFC47B6AC",
  "steps": [
    {
      "uuid": "1977E8AD-D165-52D5-9F26-2A27CB59089C",
      "isEnabled": true,
      "platforms": 3,
      "type": "script",
      "data": {
        "script": "const HUB = {\"name\": \"NA Hub\", \"action_uuid\": \"EFDD0B25-BE3A-5B1C-A849-23267A8427DF\", \"step_uuid\": \"1977E8AD-D165-52D5-9F26-2A27CB59089C\", \"group_uuid\": \"74F74B68-4973-572B-A509-EBCDFC47B6AC\", \"tags\": [\"mach\", \"na\"], \"bookmark\": \"machine-flows\", \"template_dir\": \"config/drafts/na-templates\", \"destinations\": {\"default\": \"files/inbox/prompts\", \"subsystem-prompt\": \"files/inbox/subsystems\"}, \"templates\": [{\"file\": \"pillar-prompt.md\", \"label\": \"New pillar prompt\", \"text\": \"---\\nmach: 1\\ntype: subsystem-prompt\\ntitle: Pillar prompt\\nsubsystem: na\\nunit: research\\nrole: lead\\nreply: inbox\\nmachine: any\\ndue: \\\"\\\"\\ntags: [na]\\n---\\nSet unit above to the pillar ID from mach subsystem show na.\\nCLI equivalent: mach na <pillar> \\\"<prompt>\\\".\\n\\n## Prompt\\nDescribe the outcome, context, constraints and decision needed.\\nDo not publish or post; return a reviewable draft.\\n\", \"type\": \"subsystem-prompt\"}, {\"file\": \"sector-research.md\", \"label\": \"Sector research brief\", \"text\": \"---\\nmach: 1\\ntype: research\\ntitle: Sector research\\nquestion: What opportunity does this sector present for NA?\\noutput: files/research/na/sector-brief.md\\ndepth: quick\\nsources: [web, files]\\nmachine: any\\ndue: \\\"\\\"\\napproval: before-apply\\ntags: [na]\\n---\\n## Sector\\nName and boundaries:\\n\\n## Evidence\\nSources, access dates, companies, regional relevance, contrary evidence and unknowns.\\n\", \"type\": \"research\"}, {\"file\": \"company-profile.md\", \"label\": \"Company profile\", \"text\": \"---\\nmach: 1\\ntype: task\\ntitle: Company profile to intel sheets\\ngoal: Prepare a sourced company profile for the intel sheet set\\ntool: auto\\noutput: files/research/na/company-profile.md\\napproval: before-apply\\nmachine: any\\ndue: \\\"\\\"\\ntags: [na]\\n---\\nCompany name and website:\\nTarget sheet set and row key:\\nInclude sector, location, contacts, sources and access dates.\\nPrepare proposed CSV rows for review; do not edit or rebuild sheets automatically.\\n\", \"type\": \"task\"}, {\"file\": \"linear-issue.md\", \"label\": \"NA Linear issue\", \"text\": \"---\\nmach: 1\\ntype: task\\ntitle: NA Linear issue\\ngoal: Prepare an NA issue brief for review\\ntool: auto\\noutput: linear-comment\\napproval: before-apply\\nmachine: any\\ndue: \\\"\\\"\\ntags: [na]\\n---\\nTeam: NA\\nExisting ticket ID or proposed title:\\nProblem, evidence, scope, acceptance criteria and links:\\nPrepare a handoff only. Do not create issues, post comments or change status.\\n\", \"type\": \"task\"}, {\"file\": \"mags-piece.md\", \"label\": \"MAGS piece\", \"text\": \"---\\nmach: 1\\ntype: subsystem-prompt\\ntitle: MAGS piece\\nsubsystem: na\\nunit: mags\\nrole: lead\\nreply: inbox\\nmachine: any\\ndue: \\\"\\\"\\ntags: [na]\\n---\\n## Format\\nChoose START, SECTORS, SOLOS or PLACES. START exists; the other formats are proposed.\\n\\n## Brief\\nAudience, angle, source links, outline, evidence gaps and approval needed.\\nReturn a draft only; do not publish.\\n\", \"type\": \"subsystem-prompt\"}, {\"file\": \"newsline.md\", \"label\": \"Newsline\", \"text\": \"---\\nmach: 1\\ntype: subsystem-prompt\\ntitle: Newsline candidate\\nsubsystem: na\\nunit: newslines\\nrole: lead\\nreply: inbox\\nmachine: any\\ndue: \\\"\\\"\\ntags: [na]\\n---\\nSource URL and access date:\\nEntity and pillar:\\nShort paraphrase, regional significance, contrary evidence and decision needed.\\nReturn a candidate only; do not publish.\\n\", \"type\": \"subsystem-prompt\"}, {\"file\": \"decision-needed.md\", \"label\": \"Decision needed\", \"text\": \"---\\nmach: 1\\ntype: task\\ntitle: Decision needed\\ngoal: Prepare a decision record for the responsible pillar\\ntool: auto\\noutput: files/research/na/decision-needed.md\\napproval: before-apply\\nmachine: any\\ndue: \\\"\\\"\\ntags: [na]\\n---\\nPillar and owner:\\nDecision and deadline:\\nOptions, recommendation, evidence, tradeoffs and unresolved questions:\\nRecord the proposed decision for review; do not apply it.\\n\", \"type\": \"task\"}, {\"file\": \"meeting-notes.md\", \"label\": \"Meeting notes to a pillar\", \"text\": \"---\\nmach: 1\\ntype: subsystem-prompt\\ntitle: Meeting notes to pillar\\nsubsystem: na\\nunit: research\\nrole: lead\\nreply: inbox\\nmachine: any\\ndue: \\\"\\\"\\ntags: [na]\\n---\\nSet unit above to the receiving pillar ID.\\nDate, attendees and source notes:\\n\\n## Notes\\nPaste meeting notes here.\\n\\nExtract decisions, open questions and actions with owners and dates.\\nReturn a reviewable handoff; do not send messages.\\n\", \"type\": \"subsystem-prompt\"}, {\"file\": \"web-clip.md\", \"label\": \"Web clip to research folder\", \"text\": \"---\\nmach: 1\\ntype: research\\ntitle: Web clip\\nquestion: What does this source establish and why does it matter?\\noutput: files/research/na/web-clip.md\\ndepth: quick\\nsources: [web, files]\\nmachine: any\\ndue: \\\"\\\"\\napproval: before-apply\\ntags: [na]\\n---\\nURL:\\nTitle, author and publication date:\\nAccess date:\\nDestination research folder (edit output above):\\n\\n## Clip\\nPaste excerpt and context. Distinguish quotation, paraphrase and inference.\\n\", \"type\": \"research\"}], \"actions\": [\"Send to pillar bot\"], \"send_types\": [\"subsystem-prompt\"], \"subsystem\": \"na\"};\nconst RULES = {\"schema\": {\"task\": {\"required\": [\"mach\", \"type\", \"title\", \"goal\", \"tool\", \"output\"], \"optional\": [\"permission\", \"path\", \"machine\", \"due\", \"approval\", \"tags\"]}, \"research\": {\"required\": [\"mach\", \"type\", \"title\", \"question\", \"output\"], \"optional\": [\"permission\", \"depth\", \"tool\", \"sources\", \"machine\", \"due\", \"approval\", \"tags\"]}, \"flow\": {\"required\": [\"mach\", \"type\", \"title\", \"flow\", \"input\"], \"optional\": [\"machine\", \"due\", \"approval\", \"output\", \"tags\"]}, \"subsystem-prompt\": {\"required\": [\"mach\", \"type\", \"title\", \"subsystem\", \"unit\"], \"optional\": [\"to\", \"role\", \"reply\", \"tags\", \"machine\", \"due\"]}, \"subsystem-setup\": {\"required\": [\"mach\", \"type\", \"title\", \"id\", \"name\", \"working_root\", \"max_fires_per_day\", \"reply\"], \"optional\": [\"linear_team\", \"note_dest\", \"due\", \"tags\"]}, \"unit-setup\": {\"required\": [\"mach\", \"type\", \"title\", \"subsystem\", \"unit\"], \"optional\": [\"due\", \"tags\"]}, \"role-change\": {\"required\": [\"mach\", \"type\", \"title\", \"subsystem\", \"unit\", \"role\", \"to\", \"date\", \"reason\"], \"optional\": [\"due\", \"tags\"]}}, \"version\": 1, \"enums\": {\"permission\": [\"read-only\", \"write\"], \"tool\": [\"claude\", \"codex\", \"cursor-agent\", \"grokcli-agent\", \"kiro\", \"auto\"], \"machine\": [\"deb\", \"macbook1\", \"any\"], \"approval\": [\"none\", \"before-run\", \"before-apply\"], \"depth\": [\"quick\", \"deep\"], \"reply\": [\"chat\", \"inbox\"]}, \"sources\": [\"web\", \"repo\", \"linear\", \"files\"], \"text_required\": [\"title\", \"goal\", \"question\", \"flow\", \"subsystem\", \"unit\", \"id\", \"name\", \"working_root\", \"role\", \"to\", \"date\", \"reason\"], \"text_optional\": [\"path\", \"input\", \"output\", \"due\"], \"dates\": [\"date\", \"due\"], \"lists\": [\"tags\", \"sources\"]};\n/* Flat YAML subset used by lib/frontmatter.py. No Drafts globals needed. */\nfunction stripComment(s) {\n  let quote = null;\n  for (let i = 0; i < s.length; i++) {\n    const c = s[i];\n    if (quote) { if (c === quote) quote = null; }\n    else if ('\\\"\\''.includes(c)) quote = c;\n    else if (c === '#' && (i === 0 || /[ \\t]/.test(s[i-1]))) return s.slice(0,i).trimEnd();\n  }\n  return s.trimEnd();\n}\nfunction unquote(s) {\n  s = s.trim();\n  if (s.length >= 2 && s[0] === s[s.length-1] && '\"\\''.includes(s[0])) {\n    const inner = s.slice(1,-1);\n    return s[0] === '\"' ? inner.replace(/\\\\\"/g,'\"').replace(/\\\\\\\\/g,'\\\\') : inner;\n  }\n  return s;\n}\nfunction parseValue(raw) {\n  const s = stripComment(raw).trim();\n  if (!s) return '';\n  if (s[0] === '[') {\n    if (!s.endsWith(']')) throw Error('unterminated list');\n    let quote = null, buf = '', parts = [];\n    for (const c of s.slice(1,-1)) {\n      if (quote) { buf += c; if (c === quote) quote = null; }\n      else if ('\"\\''.includes(c)) { quote = c; buf += c; }\n      else if (c === ',') { parts.push(buf); buf = ''; }\n      else buf += c;\n    }\n    parts.push(buf);\n    return parts.filter(x=>x.trim()).map(unquote);\n  }\n  if (s[0] === '{') throw Error('nested values are not supported');\n  if ('\"\\''.includes(s[0])) {\n    if (s.length < 2 || s[s.length-1] !== s[0]) throw Error('unterminated quoted string');\n    return unquote(s);\n  }\n  if (/^-?\\d+$/.test(s)) return Number(s);\n  if (s === 'true' || s === 'false') return s === 'true';\n  return s;\n}\nfunction check(text) {\n  const m = Object.create(null), problems = [], warnings = [], lines = String(text).split('\\n');\n  if (lines[0].trimEnd() !== '---') return {m, problems:['Missing frontmatter'], warnings};\n  const end = lines.findIndex((x,i)=>i>0 && x.trimEnd()==='---');\n  if (end < 0) problems.push('Missing closing ---');\n  else for (let i=1;i<end;i++) {\n    const raw=lines[i];\n    if (!raw.trim() || raw.trimStart().startsWith('#')) continue;\n    const hit=/^([A-Za-z_][A-Za-z0-9_-]*)\\s*:(?:\\s+(.*)|\\s*)$/.exec(raw.trimEnd());\n    if (/^[ \\t]/.test(raw) || !hit) { problems.push('Invalid line '+(i+1)); continue; }\n    const key=hit[1];\n    if (Object.prototype.hasOwnProperty.call(m,key)) { problems.push('Duplicate '+key); continue; }\n    try { m[key]=parseValue(hit[2] || ''); } catch(e) { problems.push(key+': '+e.message); }\n  }\n  const has=k=>Object.prototype.hasOwnProperty.call(m,k);\n  const spec=typeof m.type==='string' && Object.prototype.hasOwnProperty.call(RULES.schema,m.type) ? RULES.schema[m.type] : null;\n  if (!spec) problems.push('Unknown type');\n  if (m.mach !== RULES.version) problems.push('Unsupported mach version');\n  if (spec) {\n    spec.required.forEach(k=>{if(!has(k)) problems.push('Missing '+k);});\n    Object.keys(m).forEach(k=>{if(!spec.required.concat(spec.optional).includes(k)) problems.push('Unknown '+k);});\n  }\n  Object.keys(RULES.enums).forEach(k=>{if(has(k) && !RULES.enums[k].includes(m[k])) problems.push('Invalid '+k);});\n  RULES.text_required.concat(RULES.text_optional).forEach(k=>{\n    if (!has(k)) return;\n    if (Array.isArray(m[k]) || typeof m[k]==='boolean') problems.push(k+': expected text');\n    else if (RULES.text_required.includes(k) && String(m[k]).trim()==='') problems.push(k+': empty');\n  });\n  RULES.dates.forEach(k=>{if(has(k) && (k!=='due'||m[k]!=='') && !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(m[k]))) problems.push('Invalid '+k);});\n  RULES.lists.forEach(k=>{if(has(k) && !Array.isArray(m[k])) problems.push(k+': expected list');});\n  if (Array.isArray(m.sources)) m.sources.forEach(x=>{if(!RULES.sources.includes(x)) problems.push('Invalid source');});\n  if (['task','research'].includes(m.type) && has('output') && typeof m.output==='string' && m.output.trim()==='') problems.push('Empty output');\n  if (m.type==='flow' && has('input') && typeof m.input==='string' && m.input.trim()==='') warnings.push('input is empty: the flow starts with no input');\n  return {m,problems,warnings};\n}\n\n(() => {\n  function show(title,message) {\n    const p=Prompt.create(); p.title=title; p.addLabel('message',message); p.addButton('OK'); p.show();\n  }\n  function cancel() { context.cancel(); }\n  function next(m,path) {\n    if (m.type==='subsystem-prompt') return 'mach run '+path+' --dry-run\\nReview routing, then run: mach run '+path;\n    const verbs={'subsystem-setup':'new','unit-setup':'unit','role-change':'role'};\n    return verbs[m.type] ? 'mach subsystem '+verbs[m.type]+' '+(m.id||m.subsystem)+' --from '+path : 'mach run --inbox';\n  }\n  try {\n    const templates=HUB.templates, labels=templates.map(t=>t.label).concat(HUB.actions || ['Check frontmatter','Send to mach','Show next step']);\n    const menu=Prompt.create(); menu.title=HUB.name;\n    menu.addSelect('choice','Action',labels,[labels[0]],false); menu.addButton('Go');\n    if (!menu.show()) { cancel(); return; }\n    const choice=labels.indexOf((menu.fieldValues.choice||[])[0]);\n    if (choice<0) { cancel(); return; }\n    if (choice<templates.length) {\n      const t=templates[choice], d=Draft.create(), tomorrow=new Date();\n      tomorrow.setDate(tomorrow.getDate()+1);\n      const date=tomorrow.getFullYear()+'-'+String(tomorrow.getMonth()+1).padStart(2,'0')+'-'+String(tomorrow.getDate()).padStart(2,'0');\n      d.content=t.text.replace(/^due:[ \\t]*(?:\"\"|'')?[ \\t]*(?:#.*)?$/m,'due: '+date);\n      HUB.tags.concat([t.type]).forEach(tag=>d.addTag(tag)); d.update(); editor.load(d); return;\n    }\n    const action=labels[choice];\n    if (action==='Quick capture') {\n      draft.addTag('mach-outbox'); draft.update();\n      show('Captured','Tagged mach-outbox for triage; the collector wraps plain notes as task briefs.'); return;\n    }\n    if (['Status','Open result','Approve','Reject'].includes(action)) {\n      const uuidPattern=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n      const links=draft.tags.filter(t=>t.startsWith('mach-request-'));\n      const request=draft.tags.includes('mach-result') ? (links.length===1 ? links[0].slice(13) : '') : draft.uuid;\n      if (!uuidPattern.test(request)) throw Error('Missing or invalid request UUID');\n      const id=request.toLowerCase(), tag='mach-request-'+id;\n      const results=Draft.query('', 'all', ['mach-result',tag], false, 'modified', true, false);\n      if (action==='Open result') {\n        if (results.length===1) editor.load(results[0]);\n        else show('Result',results.length ? 'Multiple linked results; resolve duplicate results first.' : 'Not connected yet: no linked mach-result draft.');\n        return;\n      }\n      if (action==='Status') {\n        show('Status',results.length===1 ? results[0].content : 'Not connected yet: mach does not publish run status to Drafts.');\n        return;\n      }\n      if (device.systemName!=='macOS') {\n        show('Decision','Not connected yet: decisions require the Mac folder bookmark.'); return;\n      }\n      const decision=Prompt.create(); decision.title=action+' request?';\n      decision.addTextField('reason','Reason',''); decision.addButton(action);\n      if (!decision.show()) { cancel(); return; }\n      const reason=String(decision.fieldValues.reason||'').trim();\n      if (action==='Reject' && !reason) { show('Decision','A rejection reason is required.'); return; }\n      const bookmark=Bookmark.find(HUB.bookmark);\n      if (!bookmark) throw Error('Missing '+HUB.bookmark+' folder bookmark');\n      const fm=FileManager.createForBookmark(bookmark);\n      if (!fm.createDirectory('/files/inbox/decisions')) throw Error('Cannot create decisions directory');\n      const path='/files/inbox/decisions/'+id+'.md';\n      const body='---\\nrequest: '+id+'\\ndecision: '+action.toLowerCase()+'\\n---\\n'+reason+'\\n';\n      if (!fm.writeString(path,body)) throw Error('Decision write failed');\n      show('Decision saved',path+'\\nNot connected yet: mach does not consume decision files. Use mach approve/reject with the run ID.'); return;\n    }\n    const result=check(draft.content), m=result.m;\n    if (result.problems.length) { show('Frontmatter problems',result.problems.join('\\n')); return; }\n    if (action==='Check frontmatter') { show('Frontmatter','Valid '+m.type+(result.warnings.length?'\\nWarning: '+result.warnings.join('\\n'):'')); return; }\n    const folder=HUB.destinations[m.type]||HUB.destinations.default;\n    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(draft.uuid)) throw Error('Invalid Drafts UUID');\n    const path=folder+'/drafts-'+draft.uuid.toLowerCase()+'.md';\n    if (action==='Show next step') { show('Next step',next(m,path)); return; }\n    if (HUB.send_types && !HUB.send_types.includes(m.type)) throw Error('This send action requires: '+HUB.send_types.join(', '));\n    if (HUB.subsystem && m.subsystem!==HUB.subsystem) throw Error('Brief subsystem must be '+HUB.subsystem);\n    if (draft.tags.includes('mach-sent')) {\n      const confirm=Prompt.create(); confirm.title='Resend this draft?'; confirm.addButton('Resend');\n      if (!confirm.show()) { cancel(); return; }\n    }\n    let reason='';\n    if (device.systemName==='macOS') {\n      try {\n        const bookmark=Bookmark.find(HUB.bookmark);\n        if (!bookmark) throw Error('Missing '+HUB.bookmark+' folder bookmark');\n        const fm=FileManager.createForBookmark(bookmark);\n        fm.createDirectory('/files/inbox'); fm.createDirectory('/'+folder);\n        if (!fm.writeString('/'+path,draft.content)) throw Error('FileManager.writeString returned false');\n        draft.removeTag('mach-outbox'); draft.addTag('mach-sent'); draft.update();\n        show('Sent to mach',path+'\\n\\n'+next(m,path)); return;\n      } catch(e) { reason=String(e)+'\\n'; }\n    }\n    draft.addTag('mach-outbox'); draft.update();\n    show('Saved to outbox',reason+'tagged mach-outbox; run mach inbox pull-drafts --apply on the Mac');\n  } catch(e) { context.fail(String(e)); }\n})();\n\n",
        "allowAsync": "false"
      }
    }
  ],
  "assignTags": [],
  "shortName": "",
  "shouldConfirm": false,
  "disposition": 0,
  "groupDisposition": 0,
  "visibility": 2016,
  "backingActionType": "action",
  "backingPlatforms": 3,
  "backingIsSeparator": false,
  "logLevel": 1,
  "notificationType": 1,
  "tintColor": "yellow",
  "icon": "460-api2",
  "keyUseIcon": false,
  "actionDescription": "Create and validate mach drafts; drop them into machine-flows inbox on Mac.",
  "keyCommand": {
    "input": "",
    "commandKey": false,
    "controlKey": false,
    "shiftKey": false,
    "optionKey": false,
    "type": "action",
    "discoverabilityTitle": "NA Hub"
  }
}
