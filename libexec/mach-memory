#!/usr/bin/env python3
# mach-summary: Set up and review lessons (init skeleton, duplicates, stale, caps); collect/promote are preview-only in v1
# mach-group: upkeep
# mach-subcommands: init review collect promote
# mach-status: working collect=preview-only promote=preview-only
# mach-flag: --reindex | regenerate INDEX.md (only when it carries the mach marker) | off
# mach-flag: --save | write the review to the reviews folder as YYYY-MM.md | off
# mach-usage: mach memory init [--reindex] [--apply] [--json]
# mach-usage: mach memory review [--save] [--apply] [--json]
# mach-usage: mach memory collect          (PREVIEW-ONLY in v1: lists raw memory files it would turn into proposed lessons)
# mach-usage: mach memory promote          (PREVIEW-ONLY in v1: lists promotion candidates for AGENTS.md; changes nothing)
# mach-help: init previews, and with --apply creates the plan 09 skeleton under service-memories/lessons/ without overwriting anything
# mach-help: that exists: README.md (frontmatter template + writing rules), INDEX.md (generated from lesson frontmatter), the starter topic
# mach-help: folders and archived/INDEX.md. The existing reviews/ folder is left alone. Backup + rollback line; rollback removes only what
# mach-help: init created. --reindex regenerates INDEX.md from the lessons' frontmatter (backs up the old one first).
# mach-help: review scans service-memories/lessons/**/*.md (plan 09 schema: id, title, date, source, scope, confidence, review_by,
# mach-help: status ...) and reports: missing fields, stale (review_by past), duplicate candidates (title/slug similarity),
# mach-help: contradiction CANDIDATES (similar titles, opposite advice words), proposed backlog, promotion candidates and cap breaches
# mach-help: (index 300 lines, proposed 30, 40 per topic, 300 live, ~40 lines per lesson, AGENTS.md 130/150). Report goes to stdout;
# mach-help: --save also writes it to <machine-flows>/service-memories/lessons/reviews/YYYY-MM.md (plan 09 section 7). The folder is
# mach-help: created if missing, with a short README.md saying what the files are. An existing file for the month is never overwritten:
# mach-help: the next save becomes YYYY-MM-2.md, then -3 and so on. Override the folder with [memory] reviews_dir or MACH_REVIEWS_DIR.
# mach-help: --apply moves lessons already marked superseded/archived (or low-confidence and 90+ days past review_by) into
# mach-help: lessons/archived/<topic>/ with status: archived, backs up first, removes their INDEX.md lines and prints a rollback line.
# mach-help: If INDEX.md is a generated one (it carries the "generated by mach" marker) --apply regenerates it after archiving.
# mach-help: A missing lessons folder or INDEX.md is INFO, not a warning: fix it with `mach memory init --apply`. The legacy ~/machine-flows/files/Lessons is noted but not touched
# mach-help: (migration is `mach memory migrate`, a later step). collect and promote never write anything in v1.
import argparse
import difflib
import json
import os
import re
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ.get("MACH_HOME") or os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

import mach_common as mc  # noqa: E402
import frontmatter as fm  # noqa: E402

REQUIRED = ["id", "title", "date", "source", "scope.tools", "scope.machines", "confidence", "review_by", "status"]
NEG = re.compile(r"\b(never|don't|do not|avoid|not|no|without|stop)\b", re.I)
OPPOSITES = [("enable", "disable"), ("use", "avoid"), ("copy", "link"), ("symlink", "copy"), ("allow", "forbid"), ("always", "never"), ("on", "off")]


class Lesson(object):
    def __init__(self, path, topic, doc):
        self.path = path
        self.topic = topic
        self.meta = doc.meta
        self.lines = doc.body.count("\n") + len(doc.meta) + 3
        self.errors = doc.errors
        self.name = os.path.basename(path)
        self.slug = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", self.name[:-3])

    def get(self, key, default=""):
        v = self.meta.get(key, default)
        return v if v is not None else default

    @property
    def status(self):
        return str(self.get("status", "active"))

    @property
    def title(self):
        return str(self.get("title", self.slug))


def lessons_root():
    return mc.rel_to_mf(load_cfg().get("memory.lessons_dir", "service-memories/lessons"))


_CFG = []


def load_cfg():
    if not _CFG:
        _CFG.append(mc.load_config_or_warn())
    return _CFG[0]


def scan(root):
    out = []
    for dp, dn, fns in os.walk(root):
        rel = os.path.relpath(dp, root)
        dn[:] = sorted(d for d in dn if d not in ("archived", "reviews"))
        for fn in sorted(fns):
            if not fn.endswith(".md") or fn.lower() in ("index.md", "readme.md"):
                continue
            p = os.path.join(dp, fn)
            doc = fm.parse_text(mc.read_text(p), nested=True)
            topic = rel.split(os.sep)[0] if rel != "." else "(root)"
            out.append(Lesson(p, topic, doc))
    return out


def similar(a, b):
    return difflib.SequenceMatcher(None, a.lower(), b.lower()).ratio()


def scope_overlap(a, b):
    def vals(l):
        t = l.get("scope.tools", []) or []
        m = l.get("scope.machines", []) or []
        return set(t if isinstance(t, list) else [t]), set(m if isinstance(m, list) else [m])
    ta, ma = vals(a)
    tb, mb = vals(b)
    tool_ok = not ta or not tb or "all" in ta or "all" in tb or ta & tb
    mach_ok = not ma or not mb or "all" in ma or "all" in mb or ma & mb
    return bool(tool_ok and mach_ok)


def contradicts(a, b):
    if similar(a.title, b.title) < 0.5 or not scope_overlap(a, b):
        return False
    ta, tb = a.title.lower(), b.title.lower()
    if bool(NEG.search(ta)) != bool(NEG.search(tb)):
        return True
    for x, y in OPPOSITES:
        wx = re.compile(r"\b%s\b" % x)
        wy = re.compile(r"\b%s\b" % y)
        if (wx.search(ta) and wy.search(tb)) or (wy.search(ta) and wx.search(tb)):
            return True
    return False


def reviews_root(cfg, root):
    """Where --save writes: $MACH_REVIEWS_DIR, else [memory] reviews_dir, else <lessons_dir>/reviews."""
    env = os.environ.get("MACH_REVIEWS_DIR")
    conf = str(cfg.get("memory.reviews_dir", "") or "")
    if env:
        return mc.rel_to_mf(env)
    return mc.rel_to_mf(conf) if conf else os.path.join(root, "reviews")


REVIEWS_README = """# Lesson reviews

Each file here is a report written by `mach memory review --save` (one per month, named `YYYY-MM.md`; a second save in the same
month becomes `YYYY-MM-2.md`, and so on). They are proposals only (plan 09 section 7): nothing in them has been applied. Lessons
change only after you approve the numbered items, and `mach memory review --apply` backs up first and prints a rollback line.

These files are not lessons and are not read by agents by default.
"""


def save_review(text, cfg, root):
    """Write the report to reviews_dir/YYYY-MM[-N].md without clobbering; returns the path."""
    d = reviews_root(cfg, root)
    if not os.path.isdir(d):
        os.makedirs(d)
        mc.write_text(os.path.join(d, "README.md"), REVIEWS_README)
    month = mc.now().strftime("%Y-%m")
    out, n = os.path.join(d, month + ".md"), 1
    while os.path.exists(out):
        n += 1
        out = os.path.join(d, "%s-%d.md" % (month, n))
    mc.write_text(out, text)
    return out


def today():
    return mc.now().strftime("%Y-%m-%d")


def days_between(a, b):
    import datetime
    try:
        da = datetime.datetime.strptime(a, "%Y-%m-%d")
        db = datetime.datetime.strptime(b, "%Y-%m-%d")
        return (db - da).days
    except ValueError:
        return None


def review(root, cfg):
    rep = {"root": mc.tilde(root), "exists": os.path.isdir(root), "findings": [], "archive": [], "counts": {}, "legacy": None}
    legacy = os.path.join(mc.mf_root(), "files", "Lessons")
    if os.path.isdir(legacy):
        idx = mc.read_text(os.path.join(legacy, "INDEX.md"))
        rep["legacy"] = "files/Lessons exists (INDEX.md: %d lines): legacy knowledge base, not scanned; migration is `mach memory migrate` (later, preview first)" % len(idx.splitlines())
    if not rep["exists"]:
        rep["findings"].append(("INFO", "no lessons folder yet at %s; run: mach memory init --apply" % mc.tilde(root)))
        return rep
    ls = scan(root)
    live = [l for l in ls if l.status not in ("archived",)]
    by_status = {}
    for l in ls:
        by_status[l.status] = by_status.get(l.status, 0) + 1
    rep["counts"] = {"lessons": len(ls), "by_status": by_status}
    F = rep["findings"]
    now = today()
    # missing fields / parse problems
    for l in ls:
        missing = [k for k in REQUIRED if k not in l.meta]
        if missing:
            F.append(("WARN", "%s: missing field(s): %s" % (os.path.relpath(l.path, root), ", ".join(missing))))
        for ln, msg in l.errors:
            F.append(("WARN", "%s:%d: %s" % (os.path.relpath(l.path, root), ln, msg)))
        if l.lines > 45:
            F.append(("WARN", "%s: about %d lines (cap ~40): move detail into a linked doc" % (os.path.relpath(l.path, root), l.lines)))
    # stale
    for l in live:
        rb = str(l.get("review_by", ""))
        if rb and rb < now and l.status in ("active", "proposed", "promoted"):
            late = days_between(rb, now)
            F.append(("WARN", "stale: %s review_by %s passed %s day(s) ago (re-verify, extend or archive)" % (os.path.relpath(l.path, root), rb, late)))
            if late is not None and late > 90 and str(l.get("confidence", "")) == "low":
                rep["archive"].append((l, "stale: low confidence, review_by %s is %d days past" % (rb, late)))
    for l in ls:
        if l.status in ("superseded", "archived"):
            rep["archive"].append((l, "status is %s but the file is still in the live tree" % l.status))
    seen = set()
    rep["archive"] = [(l, r) for l, r in rep["archive"] if not (l.path in seen or seen.add(l.path))]
    # duplicates
    cands = [l for l in live if l.status in ("active", "proposed", "promoted")]
    for i in range(len(cands)):
        for j in range(i + 1, len(cands)):
            a, b = cands[i], cands[j]
            if contradicts(a, b):
                F.append(("WARN", "contradiction candidate: %s vs %s (similar titles, opposite advice): decide which wins" % (os.path.relpath(a.path, root), os.path.relpath(b.path, root))))
            elif similar(a.title, b.title) >= 0.8 or similar(a.slug, b.slug) >= 0.85:
                F.append(("WARN", "duplicate candidate: %s ~ %s (title similarity %.2f): merge, one becomes superseded" % (os.path.relpath(a.path, root), os.path.relpath(b.path, root), similar(a.title, b.title))))
    # caps
    proposed = [l for l in live if l.status == "proposed"]
    cap_p = int(cfg.get("doctor.proposed_max", 30))
    if len(proposed) > cap_p:
        F.append(("WARN", "proposed backlog %d > %d: hold a review before adding more" % (len(proposed), cap_p)))
    elif proposed:
        F.append(("INFO", "proposed backlog: %d (activate, edit or reject each at the review; cap %d)" % (len(proposed), cap_p)))
    topics = {}
    for l in cands:
        topics[l.topic] = topics.get(l.topic, 0) + 1
    for t, n in sorted(topics.items()):
        if n > 40:
            F.append(("WARN", "topic '%s' has %d live lessons (cap ~40): split it" % (t, n)))
    if len(cands) > 300:
        F.append(("WARN", "%d live lessons (cap ~300): archive harder, raise the bar for new ones" % len(cands)))
    idx_lines = len(mc.read_text(os.path.join(root, "INDEX.md")).splitlines())
    cap_i = int(cfg.get("doctor.lessons_index_max_lines", 300))
    if os.path.isfile(os.path.join(root, "INDEX.md")):
        if idx_lines > cap_i:
            F.append(("WARN", "INDEX.md has %d lines (cap %d): split into per-topic indexes" % (idx_lines, cap_i)))
        text = mc.read_text(os.path.join(root, "INDEX.md"))
        for l in cands:
            rel = os.path.relpath(l.path, root).replace(os.sep, "/")
            if rel not in text:
                F.append(("WARN", "not in INDEX.md: %s" % rel))
        for m in re.finditer(r"→\s*(\S+\.md)", text):
            if not os.path.isfile(os.path.join(root, m.group(1))):
                F.append(("WARN", "INDEX.md points to a missing file: %s" % m.group(1)))
    else:
        F.append(("INFO", "INDEX.md not found in %s; run: mach memory init --apply" % mc.tilde(root)))
    agents = os.path.join(mc.mf_root(), "ai-authored", "AGENTS.md")
    agents_n = len(mc.read_text(agents).splitlines()) if os.path.isfile(agents) else None
    # promotion candidates
    for l in cands:
        try:
            conf = int(l.get("confirmations", 0) or 0)
        except (TypeError, ValueError):
            conf = 0
        if l.status == "active" and conf >= 3 and str(l.get("confidence", "")) == "high":
            room = "" if agents_n is None else " (AGENTS.md has %d of ~150 lines)" % agents_n
            F.append(("INFO", "promotion candidate: %s (%d confirmations, high confidence)%s: needs your approval" % (os.path.relpath(l.path, root), conf, room)))
    return rep


def render(rep):
    lines = ["# mach memory review (%s on %s)" % (today(), mc.host()), "", "lessons folder: %s%s" % (rep["root"], "" if rep["exists"] else " (absent)")]
    if rep["legacy"]:
        lines.append("note: " + rep["legacy"])
    if rep["counts"]:
        by = ", ".join("%d %s" % (v, k) for k, v in sorted(rep["counts"]["by_status"].items()))
        lines.append("lessons: %d%s" % (rep["counts"]["lessons"], " (%s)" % by if by else ""))
    lines.append("")
    if not rep["findings"]:
        lines.append("OK  no findings")
    n = 0
    for lv, msg in rep["findings"]:
        n += 1
        lines.append("R%d  %-4s  %s" % (n, lv, msg))
    if rep["archive"]:
        lines.append("")
        lines.append("proposed archives (apply with --apply):")
        for l, why in rep["archive"]:
            lines.append("  - %s: %s" % (os.path.relpath(l.path, lessons_root()), why))
    return "\n".join(lines) + "\n"


def apply_archives(rep, root):
    bk = mc.Backup("memory")
    moved = []
    index = os.path.join(root, "INDEX.md")
    ai = os.path.join(root, "archived", "INDEX.md")
    if os.path.isfile(index):
        bk.save(index)
    if os.path.isfile(ai):
        bk.save(ai)
    else:
        bk.created(ai)
    index_text = mc.read_text(index)
    add_lines = []
    for l, why in rep["archive"]:
        rel = os.path.relpath(l.path, root).replace(os.sep, "/")
        dest = os.path.join(root, "archived", rel)
        bk.save(l.path)
        bk.created(dest)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        text = mc.read_text(l.path)
        text = set_front(text, {"status": "archived", "archived": today(), "reason": why})
        mc.write_text(dest, text)
        os.remove(l.path)
        index_text = "\n".join(ln for ln in index_text.split("\n") if rel not in ln)
        add_lines.append("- [%s] %s · archived %s · %s → archived/%s" % (l.topic, l.title, today(), why, rel))
        moved.append(rel)
    if os.path.isfile(index):
        if GEN_MARK in index_text:
            index_text = generate_index(root, scan(root), load_cfg())
        mc.write_text(index, index_text if index_text.endswith("\n") else index_text + "\n")
    prev = mc.read_text(ai)
    mc.write_text(ai, (prev.rstrip() + "\n" if prev.strip() else "# Archived lessons\n\n") + "\n".join(add_lines) + "\n")
    hint = bk.finish(quiet=True)
    return moved, "backup: " + mc.tilde(bk.dir) + "\n" + hint


def set_front(text, updates):
    """Set/replace top-level keys in the frontmatter block, keeping everything else byte-for-byte."""
    lines = text.split("\n")
    if not lines or lines[0].rstrip() != "---":
        return text
    end = next((i for i in range(1, len(lines)) if lines[i].rstrip() == "---"), None)
    if end is None:
        return text
    head = lines[1:end]
    for k, v in updates.items():
        newline = "%s: %s" % (k, v if not re.search(r"[:#]", str(v)) else '"%s"' % str(v).replace('"', "'"))
        for i, ln in enumerate(head):
            if re.match(r"^%s\s*:" % re.escape(k), ln):
                head[i] = newline
                break
        else:
            head.append(newline)
    return "\n".join([lines[0]] + head + lines[end:])


def preview_collect():
    h = mc.home()
    src = []
    cx = os.path.join(h, ".codex", "memories")
    if os.path.isdir(cx):
        src.append(("codex", cx, len([f for f in os.listdir(cx) if f.endswith(".md")])))
    pj = os.path.join(h, ".claude", "projects")
    if os.path.isdir(pj):
        n = 0
        for p in os.listdir(pj):
            md = os.path.join(pj, p, "memory")
            if os.path.isdir(md):
                n += len([f for f in os.listdir(md) if f.endswith(".md")])
        src.append(("claude", pj, n))
    print("PREVIEW-ONLY (v1): mach memory collect would draft `status: proposed` lessons from local raw memory.")
    print("Raw memory is never copied or synced; only paraphrased lessons would be written, after your approval.")
    if not src:
        print("no local raw memory folders found (~/.codex/memories, ~/.claude/projects/*/memory).")
    for tool, path, n in src:
        print("  %-7s %s: %d markdown file(s) would be read" % (tool, mc.tilde(path), n))
    print("nothing was read or written.")
    return 0


def preview_promote(rep):
    cands = [m for lv, m in rep["findings"] if m.startswith("promotion candidate")]
    print("PREVIEW-ONLY (v1): mach memory promote would move an approved lesson into an AGENTS.md rule (one in, one out above 150 lines).")
    if not rep["exists"]:
        print("no lessons folder yet, so there is nothing to promote.")
        return 0
    if not cands:
        print("no lesson meets the promotion bar (3 confirmations, high confidence, active).")
    for c in cands:
        print("  " + c)
    print("nothing was changed.")
    return 0


TOPICS = ["sync", "ai-tools", "cli", "mcp", "drafts", "macos", "linux", "git", "coding", "projects"]
GEN_MARK = "<!-- generated by mach memory from lesson frontmatter (mach memory init --reindex, review --apply); do not edit by hand -->"
LIVE = ("proposed", "active", "promoted")

LESSONS_README = """# Lessons

One lesson per file: `<topic>/<YYYY-MM-DD>-<slug>.md` (plan 09 sections 3 to 5). Read `INDEX.md` first, open 3 to 5 lesson files at most,
and leave `archived/` alone unless you are tracing history. `mach memory review` proposes merges, fixes and archives; you approve them.

Topics (add one only when 3 lessons need it; split one past ~40 live lessons): %(topics)s.
Under `projects`, file names start with the project id from `service-memories/project-map.tsv`.

## Frontmatter (everything above `# optional` is required)

```yaml
---
id: L-2026-10-08-cli-agent-names
title: Cursor and grok installers recreate a bare `agent` command
date: 2026-10-08                 # first recorded
source: Grok Bot session 2026-10-08 (plan 06 section 9.7)   # session, memory snapshot, plan or log; never pasted text
scope:
  tools: [cursor-agent, grokcli-agent]    # or [all]
  machines: [linux-box, mac-laptop]               # or [all]
confidence: high                 # low | medium | high
review_by: 2027-01-08            # default: date + 3 months (low), 6 (medium), 12 (high)
status: proposed                 # proposed | active | promoted | superseded | archived
# optional
updated: 2026-10-08
confirmations: 1                 # independent re-confirmations, each dated in the body
promoted_to: ""                  # the AGENTS.md rule, when promoted
supersedes: []                   # ids this lesson replaces
---
```

## Body (about 40 lines at most)

- **Lesson:** 1 to 3 sentences saying what to do or avoid.
- **Applies when:** the trigger, such as a tool, situation or path.
- **Why / evidence:** a short paraphrase, with links to the plan, log or commit.
- **Confirmations:** dated one-liners, added each time the lesson held again.

## Writing rules

- Check `INDEX.md` before writing. If a matching lesson exists, add a confirmation to it instead of creating a new file.
- New lessons start as `status: proposed` with confidence `low` or `medium`; the user activates them at the review.
- No secret values. No raw transcripts. No verbatim third-party text (issues, web pages, tool output): paraphrase it.
- Write paths as `~/...` so a lesson reads the same on every machine.
- If a lesson proves wrong, add a dated "Contradicted:" line and leave the decision to the review.
""" % {"topics": ", ".join("`%s`" % t for t in TOPICS)}

ARCHIVED_INDEX = """# Archived lessons

Lessons moved here by `mach memory review --apply` (status archived, with a date and a reason). Never read by default.
"""


def list_csv(v):
    if isinstance(v, list):
        v = ", ".join(str(x) for x in v)
    return str(v).strip() or "all"


def last_review(root, cfg):
    d = reviews_root(cfg, root)
    names = sorted(m.group(1) for m in (re.match(r"(\d{4}-\d{2})(?:-\d+)?\.md$", f) for f in (os.listdir(d) if os.path.isdir(d) else [])) if m)
    return names[-1] if names else "never"


def generate_index(root, ls, cfg):
    """INDEX.md text in the plan 09 section 4 format: header counts, then one line per proposed/active/promoted lesson per topic."""
    live = [l for l in ls if l.status in LIVE]
    by_topic = {}
    for l in live:
        by_topic.setdefault(l.topic, []).append(l)
    agents = os.path.join(mc.mf_root(), "ai-authored", "AGENTS.md")
    agents_n = "%d of ~150 lines" % len(mc.read_text(agents).splitlines()) if os.path.isfile(agents) else "absent"
    topics = TOPICS + sorted(t for t in by_topic if t not in TOPICS)
    counts = " · ".join("%s %d" % (t, len(by_topic[t])) for t in topics if t in by_topic) or "none yet"
    out = ["# Lessons index", "", GEN_MARK, "",
           "Live lessons: %d (%s)" % (len(live), counts),
           "Last saved review: %s · AGENTS.md: %s" % (last_review(root, cfg), agents_n),
           "Tags: [proposed] not yet approved, [rule] promoted into AGENTS.md. Archived lessons are in archived/INDEX.md.", ""]
    for t in topics:
        out.append("## %s" % t)
        rows = sorted(by_topic.get(t, []), key=lambda l: l.name)
        if not rows:
            out.append("(none yet)")
        for l in rows:
            tag = {"proposed": "[proposed] ", "promoted": "[rule] "}.get(l.status, "")
            out.append("- [%s] %s%s · %s · %s · %s · review %s → %s" % (
                t, tag, l.title, list_csv(l.get("scope.tools", "")), list_csv(l.get("scope.machines", "")),
                l.get("confidence", "?"), l.get("review_by", "?"), os.path.relpath(l.path, root).replace(os.sep, "/")))
        out.append("")
    return "\n".join(out).rstrip("\n") + "\n"


def init_plan(root, cfg, reindex):
    """Returns (dirs_to_make, files_to_make {path: text}, files_to_replace {path: text}, kept)."""
    dirs, files, replace, kept = [], {}, {}, []
    for d in [root] + [os.path.join(root, t) for t in TOPICS] + [os.path.join(root, "archived")]:
        (kept if os.path.isdir(d) else dirs).append(d)
    ls = scan(root) if os.path.isdir(root) else []
    wanted = [(os.path.join(root, "README.md"), LESSONS_README), (os.path.join(root, "archived", "INDEX.md"), ARCHIVED_INDEX)]
    for path, text in wanted:
        if os.path.exists(path):
            kept.append(path)
        else:
            files[path] = text
    index = os.path.join(root, "INDEX.md")
    if not os.path.exists(index):
        files[index] = generate_index(root, ls, cfg)
    elif reindex:
        replace[index] = generate_index(root, ls, cfg)
    else:
        kept.append(index)
    return dirs, files, replace, kept


def run_init(a, cfg, root):
    dirs, files, replace, kept = init_plan(root, cfg, a.reindex)
    js = a.json or mc.env_flag("MACH_JSON")
    say = sys.stderr if js else sys.stdout
    nothing = not (dirs or files or replace)
    print("mach memory init: lessons skeleton at %s" % mc.tilde(root), file=say)
    for d in dirs:
        print("  create dir   %s" % mc.tilde(d), file=say)
    for f in sorted(files):
        print("  create file  %s" % mc.tilde(f), file=say)
    for f in sorted(replace):
        print("  regenerate   %s (old one backed up first)" % mc.tilde(f), file=say)
    print("  kept         %d existing item(s) untouched (reviews/ is never touched)" % len(kept), file=say)
    done = False
    if nothing:
        print("nothing to do: the skeleton is complete.", file=say)
    elif a.dry_run or mc.env_flag("MACH_DRY_RUN") or not mc.should_apply(a.apply, a.yes, "Create the lessons skeleton?"):
        print("preview only: run `mach memory init --apply` to create it (backup + rollback line first).", file=say)
    else:
        bk = mc.Backup("memory")
        for d in dirs:
            os.makedirs(d, exist_ok=True)
            bk.created_dir(d)
        for f, text in sorted(files.items()):
            bk.created(f)
            mc.write_text(f, text)
        for f, text in sorted(replace.items()):
            bk.save(f)
            mc.write_text(f, text)
        hint = bk.finish(quiet=True)
        print("created %d folder(s), %d file(s); regenerated %d." % (len(dirs), len(files), len(replace)), file=say)
        print("backup: " + mc.tilde(bk.dir), file=say)
        print(hint, file=say)
        done = True
    if js:
        mc.emit_json({"root": mc.tilde(root), "created_dirs": [mc.tilde(d) for d in dirs], "created_files": [mc.tilde(f) for f in sorted(files)],
                      "regenerated": [mc.tilde(f) for f in sorted(replace)], "kept": len(kept), "applied": done})
    return 0


def main():
    ap = argparse.ArgumentParser(prog="mach memory", add_help=False)
    ap.add_argument("sub", choices=["init", "review", "collect", "promote"])
    ap.add_argument("--reindex", action="store_true")
    ap.add_argument("--save", action="store_true")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--yes", "-y", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    cfg = load_cfg()
    root = lessons_root()
    if a.sub == "collect":
        return preview_collect()
    if a.sub == "init":
        return run_init(a, cfg, root)
    rep = review(root, cfg)
    if a.sub == "promote":
        return preview_promote(rep)
    text = render(rep)
    js = a.json or mc.env_flag("MACH_JSON")
    if js:
        mc.emit_json({"root": rep["root"], "exists": rep["exists"], "counts": rep["counts"], "legacy": rep["legacy"],
                      "findings": [{"level": lv, "message": m} for lv, m in rep["findings"]],
                      "archive": [{"file": os.path.relpath(l.path, root), "reason": w} for l, w in rep["archive"]]})
    else:
        sys.stdout.write(text)
    say = sys.stderr if js else sys.stdout   # --json keeps stdout for the JSON document only
    if a.save:
        out = save_review(text, cfg, root)
        print("saved report: %s" % mc.tilde(out), file=say)
    warns = any(lv == "WARN" for lv, _m in rep["findings"])
    if rep["archive"] and not a.dry_run:
        if mc.should_apply(a.apply, a.yes, "Archive %d lesson(s)?" % len(rep["archive"])):
            moved, note = apply_archives(rep, root)
            print("archived %d lesson(s): %s" % (len(moved), ", ".join(moved)), file=say)
            print(note, file=say)
        else:
            print("preview only: %d proposed archive(s); run with --apply to move them (backup + rollback line first)." % len(rep["archive"]), file=say)
    return 1 if warns else 0


if __name__ == "__main__":
    sys.exit(main())
