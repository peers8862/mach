#!/usr/bin/env python3
# mach-summary: Run a multi-step recipe (flow) with approval gates
# mach-group: gateway
# mach-subcommands: list
# mach-writes: yes list=no
# mach-usage: mach flow <name> [input...] [--dry-run] [--queue] [--write] [--json]
# mach-usage: mach flow list
# mach-help: Recipes are Markdown files with numbered steps. Searched in ~/machine-flows/autoflows/mach/<name>.md first,
# mach-help: then the built-in flows/ folder (morning, research-to-plan, issue-to-pr).
# mach-help: Step keys: tool, machine, prompt, cmd (a mach command), handoff, output; `gate:` marks an approval stop (after that step).
# mach-help: A gate pauses the run: status waiting-approval, exit 3. Continue with `mach approve <id>`, stop with `mach reject <id> "why"`.
# mach-help: Outward steps (PR, Linear, posting) are NEVER executed by mach in v1: they produce a ready-to-run command or draft
# mach-help: file in the run folder and the step is marked "handoff". The input is read from the arguments, or stdin when it is "-".
# mach-help: --dry-run lists the steps and the exact tool commands (prompts truncated) and writes nothing.
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ.get("MACH_HOME") or os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

import mach_common as mc  # noqa: E402
import mach_exec as ex  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="mach flow", add_help=False)
    ap.add_argument("name")
    ap.add_argument("input", nargs="*")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--queue", action="store_true")
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    cfg = mc.load_config_or_warn()
    dry = a.dry_run or mc.env_flag("MACH_DRY_RUN")
    js = a.json or mc.env_flag("MACH_JSON")
    rep = ex.Reporter(js)
    if a.name == "list":
        recipes = ex.list_recipes()
        if js:
            mc.emit_json([{"name": n, "source": s, "path": mc.tilde(p)} for n, (s, p) in sorted(recipes.items())])
            return 0
        for n, (s, p) in sorted(recipes.items()):
            rec = ex.fm.parse_recipe_file(p)
            title = rec.meta.get("title", "") or rec.meta.get("description", "")
            rep.say("%-16s %-9s %s" % (n, s, title))
        return 0
    text = " ".join(a.input).strip()
    if text == "-":
        text = sys.stdin.read().strip()
    rec, src = ex.load_recipe(a.name)
    if rec is None:
        mc.die("unknown flow %r (try: mach flow list)" % a.name)
    if rec.errors:
        for ln, msg in rec.errors:
            mc.eprint("%s:%d: error: %s" % (src, ln, msg))
        return mc.EXIT_FAIL
    if dry:
        rep.say("dry-run: flow %s from %s%s" % (a.name, mc.tilde(src), (" with input: " + mc.truncate(text, 60)) if text else ""))
        ex.describe_recipe(rep, rec, text, cfg)
        return 0
    _run, rc = ex.start_flow(cfg, a.name, text, rep, write=a.write, json_mode=js, queue=a.queue)
    return rc


if __name__ == "__main__":
    sys.exit(main())
