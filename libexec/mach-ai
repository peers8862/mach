#!/usr/bin/env python3
# mach-summary: Preview/apply wiring of shared AI rules and skills into each tool (plan 06)
# mach-group: upkeep
# mach-subcommands: apply show
# mach-usage: mach ai apply [rules|skills] [--tool T] [--apply]
# mach-usage: mach ai show  [rules|skills] [--tool T]        (same preview, never writes)
# mach-help: Tools: claude, codex, cursor-agent (Cursor), kiro, grokcli-agent. For each tool it shows what is wanted, what exists,
# mach-help: and the state: ok | create | refresh | differs (not safe to touch) | blocked (a source is missing) | manual.
# mach-help: rules: claude = ~/.claude/CLAUDE.md + CLAUDE.machine.md import stubs; codex = ~/.codex/AGENTS.md (generated);
# mach-help: cursor-agent = ~/.cursor/plugins/local/machine-flows/ (generated rule); kiro = ~/.kiro/steering/AGENTS.md (generated).
# mach-help: Generated files = ai-authored/AGENTS.md + claude/machines/<host>.md (+ codex/extra.md), with a "generated by mach" header.
# mach-help: skills: ai-authored/skills/<name>/ -> symlinks ~/.claude/skills/<n> and ~/.agents/skills/<n> (codex, cursor-agent; links point
# mach-help: from the tool folder INTO machine-flows, never inside it); kiro gets copies. Existing paths are never replaced.
# mach-help: --apply does only safe writes: create missing stubs/links/copies, refresh files that mach itself generated (with a
# mach-help: backup + rollback line). A file with other content (e.g. a hand-written ~/.claude/CLAUDE.md) is "differs": preview-only.
# mach-help: Not automated (manual, shown as such): Cursor account User Rules, Grok Bot private skill, credential/settings JSON.
import argparse
import hashlib
import os
import shutil
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ.get("MACH_HOME") or os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

import mach_common as mc  # noqa: E402

GEN_MARK = "generated by mach ai apply"
MAX_BYTES = 32 * 1024
TOOLS = ["claude", "codex", "cursor-agent", "kiro", "grokcli-agent"]


class Item(object):
    def __init__(self, tool, what, target, state, detail, action=None):
        self.tool, self.what, self.target, self.state, self.detail, self.action = tool, what, target, state, detail, action


def ai_dir():
    return os.path.join(mc.mf_root(), "ai-authored")


def sha(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]


def compose(host):
    """AGENTS.md + machine file (+ codex extra). Returns (text, sources, missing)."""
    parts, srcs = [], []
    base = os.path.join(ai_dir(), "AGENTS.md")
    if not os.path.isfile(base):
        return None, [], "ai-authored/AGENTS.md does not exist yet (plan 06 stage 1 / plan 09)"
    parts.append(mc.read_text(base).rstrip())
    srcs.append("ai-authored/AGENTS.md")
    mfile = os.path.join(ai_dir(), "claude", "machines", host + ".md")
    if os.path.isfile(mfile):
        parts.append(mc.read_text(mfile).rstrip())
        srcs.append("ai-authored/claude/machines/%s.md" % host)
    return "\n\n".join(parts) + "\n", srcs, ""


def generated(text, srcs, comment_open="<!-- ", comment_close=" -->"):
    head = "%s%s from %s; source hash %s; edit machine-flows, not this file%s" % (comment_open, GEN_MARK, " + ".join(srcs), sha(text), comment_close)
    return head + "\n\n" + text


def file_state(path, wanted, safe_marker):
    """(state, detail) for a file we want to hold `wanted`. safe_marker: how we recognise a file we may refresh."""
    if os.path.islink(path):
        return "differs", "is a symlink (Claude/Cursor refuse writes through links): leave it"
    if not os.path.exists(path):
        return "create", "missing"
    have = mc.read_text(path)
    if have == wanted:
        return "ok", "up to date"
    if safe_marker(have):
        return "refresh", "generated by mach earlier, source changed"
    return "differs", "has other content (not generated by mach): merge by hand"


def is_stub(text):
    """A tiny import file: only @import lines and one-line <!-- comments -->, with at least one import."""
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    imports = [ln for ln in lines if ln.startswith("@")]
    others = [ln for ln in lines if not ln.startswith("@")]
    return 0 < len(lines) <= 4 and bool(imports) and all(ln.startswith("<!--") and ln.endswith("-->") for ln in others)


def stub_state(path, want_line):
    """Import stubs may carry a comment header (the real ones do). OK when the wanted @import is already the file's import."""
    if os.path.islink(path):
        return "differs", "is a symlink (Claude/Cursor refuse writes through links): leave it"
    if not os.path.exists(path):
        return "create", "missing"
    have = mc.read_text(path)
    if not is_stub(have):
        return "differs", "has real content, not a 2-line import stub: merge by hand (plan 02)"
    imports = [ln.strip() for ln in have.splitlines() if ln.strip().startswith("@")]
    if imports == [want_line.strip()]:
        return "ok", "import stub up to date"
    return "refresh", "import stub points somewhere else"


def plan_rules(tool, host):
    items = []
    h = mc.home()
    if tool == "claude":
        stubs = [(os.path.join(h, ".claude", "CLAUDE.md"), "@~/machine-flows/ai-authored/claude/CLAUDE.md\n"),
                 (os.path.join(h, ".claude", "CLAUDE.machine.md"), "@~/machine-flows/ai-authored/claude/machines/%s.md\n" % host)]
        src = {0: os.path.join(ai_dir(), "claude", "CLAUDE.md"), 1: os.path.join(ai_dir(), "claude", "machines", host + ".md")}
        for i, (path, want) in enumerate(stubs):
            if not os.path.isfile(src[i]):
                items.append(Item(tool, "import stub", path, "blocked", "source %s is missing" % mc.tilde(src[i])))
                continue
            st, det = stub_state(path, want)
            items.append(Item(tool, "import stub", path, st, det, ("write", want) if st in ("create", "refresh") else None))
        return items
    text, srcs, missing = compose(host)
    if tool in ("codex", "kiro", "cursor-agent"):
        if text is None:
            targets = {"codex": os.path.join(h, ".codex", "AGENTS.md"),
                       "kiro": os.path.join(h, ".kiro", "steering", "AGENTS.md"),
                       "cursor-agent": os.path.join(h, ".cursor", "plugins", "local", "machine-flows", "rules", "machine-flows.mdc")}
            return [Item(tool, "rules", targets[tool], "blocked", missing)]
        extra = os.path.join(ai_dir(), "codex", "extra.md")
        body = text
        if tool == "codex" and os.path.isfile(extra):
            body = body.rstrip() + "\n\n" + mc.read_text(extra).rstrip() + "\n"
            srcs = srcs + ["ai-authored/codex/extra.md"]
        if tool in ("codex", "kiro"):
            target = os.path.join(h, ".codex", "AGENTS.md") if tool == "codex" else os.path.join(h, ".kiro", "steering", "AGENTS.md")
            want = generated(body, srcs)
            if len(want.encode("utf-8")) > MAX_BYTES and tool == "codex":
                return [Item(tool, "rules", target, "blocked", "generated text would exceed 32 KiB (Codex limit)")]
            st, det = file_state(target, want, lambda t: GEN_MARK in t.split("\n", 1)[0])
            return [Item(tool, "rules", target, st, det, ("write", want) if st in ("create", "refresh") else None)]
        base = os.path.join(h, ".cursor", "plugins", "local", "machine-flows")
        rule = os.path.join(base, "rules", "machine-flows.mdc")
        want_rule = "---\ndescription: machine-flows shared rules\nalwaysApply: true\n---\n" + generated(body, srcs)
        st, det = file_state(rule, want_rule, lambda t: GEN_MARK in t)
        items.append(Item(tool, "plugin rule", rule, st, det, ("write", want_rule) if st in ("create", "refresh") else None))
        manifest = os.path.join(base, ".cursor-plugin", "plugin.json")
        want_m = '{\n  "name": "machine-flows"\n}\n'
        st, det = file_state(manifest, want_m, lambda t: '"name": "machine-flows"' in t)
        items.append(Item(tool, "plugin manifest", manifest, st, det, ("write", want_m) if st in ("create", "refresh") else None))
        items.append(Item(tool, "User Rules", "(Cursor account settings)", "manual", "paste ai-authored/cursor/user-rules.md once in Cursor → Rules (account-wide; mach cannot write it)"))
        return items
    if tool == "grokcli-agent":
        return [Item(tool, "rules", "(none)", "manual", "no rules wiring is defined for the grok CLI; Grok Bot takes a private skill via chat (plan 06)")]
    return items


def skill_sources():
    d = os.path.join(ai_dir(), "skills")
    if not os.path.isdir(d):
        return None, []
    names = [n for n in sorted(os.listdir(d)) if os.path.isfile(os.path.join(d, n, "SKILL.md")) and n != "synced"]
    return d, names


def tree_sha(path):
    h = hashlib.sha256()
    for dp, dn, fns in sorted(os.walk(path)):
        dn.sort()
        for fn in sorted(fns):
            if fn == ".mach-copy":
                continue
            p = os.path.join(dp, fn)
            h.update(os.path.relpath(p, path).encode("utf-8"))
            with open(p, "rb") as fh:
                h.update(fh.read())
    return h.hexdigest()[:12]


def plan_skills(tool):
    base, names = skill_sources()
    h = mc.home()
    if tool == "grokcli-agent":
        return [Item(tool, "skills", "(none)", "manual", "no skills wiring is defined for the grok CLI; Grok Bot mirrors skills via chat")]
    if base is None:
        return [Item(tool, "skills", "ai-authored/skills/", "ok", "no shared skills yet (folder absent): nothing to wire")]
    if not names:
        return [Item(tool, "skills", "ai-authored/skills/", "ok", "no shared skills yet: nothing to wire")]
    roots = {"claude": [os.path.join(h, ".claude", "skills")],
             "codex": [os.path.join(h, ".agents", "skills")],
             "cursor-agent": [os.path.join(h, ".agents", "skills")],
             "kiro": [os.path.join(h, ".kiro", "skills")]}[tool]
    items = []
    for root in roots:
        for n in names:
            src = os.path.join(base, n)
            dest = os.path.join(root, n)
            if tool == "kiro":
                if not os.path.lexists(dest):
                    items.append(Item(tool, "skill copy", dest, "create", "missing", ("copy", src)))
                else:
                    marker = os.path.join(dest, ".mach-copy")
                    if os.path.isdir(dest) and os.path.isfile(marker):
                        if mc.read_text(marker).strip() == tree_sha(src):
                            items.append(Item(tool, "skill copy", dest, "ok", "up to date"))
                        else:
                            items.append(Item(tool, "skill copy", dest, "refresh", "source changed since the last copy", ("copy", src)))
                    else:
                        items.append(Item(tool, "skill copy", dest, "differs", "exists and was not copied by mach: leave it"))
            else:
                if os.path.islink(dest):
                    ok_ = os.path.realpath(dest) == os.path.realpath(src)
                    items.append(Item(tool, "skill link", dest, "ok" if ok_ else "differs", "links to the shared skill" if ok_ else "links somewhere else: leave it"))
                elif os.path.exists(dest):
                    items.append(Item(tool, "skill link", dest, "differs", "a real folder exists here: leave it"))
                else:
                    items.append(Item(tool, "skill link", dest, "create", "missing", ("link", src)))
    return items


def apply_item(it, bk):
    kind, payload = it.action
    path = it.target
    if kind == "write":
        d = os.path.dirname(path)
        if d and not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        if os.path.exists(path):
            bk.save(path)
        else:
            bk.created(path)
        mc.write_text(path, payload)
    elif kind == "link":
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.lexists(path):
            return
        os.symlink(payload, path)
        bk.created(path)
    elif kind == "copy":
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path):
            bk.save(path)
            shutil.rmtree(path)
        else:
            bk.created(path)
        shutil.copytree(payload, path)
        mc.write_text(os.path.join(path, ".mach-copy"), tree_sha(payload) + "\n")


def main():
    ap = argparse.ArgumentParser(prog="mach ai", add_help=False)
    ap.add_argument("sub", choices=["apply", "show"])
    ap.add_argument("what", nargs="?", choices=["rules", "skills"])
    ap.add_argument("--tool")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--yes", "-y", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    if a.tool and a.tool not in TOOLS:
        mc.die("unknown tool %r (use one of %s)" % (a.tool, ", ".join(TOOLS)))
    host = mc.host()
    tools = [a.tool] if a.tool else TOOLS
    items = []
    for t in tools:
        if a.what in (None, "rules"):
            items.extend(plan_rules(t, host))
        if a.what in (None, "skills"):
            items.extend(plan_skills(t))
    counts = {}
    for it in items:
        counts[it.state] = counts.get(it.state, 0) + 1
        print("%-8s %-13s %-16s %s" % (it.state.upper(), it.tool, it.what, mc.tilde(it.target)))
        print("         %s" % it.detail)
    todo = [it for it in items if it.action]
    print("")
    print("summary: " + ", ".join("%d %s" % (v, k) for k, v in sorted(counts.items())))
    if not todo:
        print("nothing to write.")
        return 0 if not any(it.state in ("differs", "blocked") for it in items) else 1
    do = a.sub == "apply" and not a.dry_run and mc.should_apply(a.apply, a.yes, "Write %d item(s)?" % len(todo))
    if not do:
        print("preview only: %d item(s) would be written. Run: mach ai apply%s --apply" % (len(todo), (" " + a.what) if a.what else ""))
        return 0
    bk = mc.Backup("ai")
    for it in todo:
        apply_item(it, bk)
        print("wrote %s" % mc.tilde(it.target))
    bk.finish()
    print("docs index: these are config files outside/inside machine-flows; run `mach docs` (preview) to refresh the index.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
