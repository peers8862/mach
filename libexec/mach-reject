#!/usr/bin/env python3
# mach-summary: Reject (cancel) a run that is waiting at a gate or queued
# mach-group: gateway
# mach-writes: yes
# mach-usage: mach reject <id> "reason"
# mach-help: Sets the run to cancelled and records the reason. <id> may be a unique prefix.
# mach-help: Nothing is deleted: the run folder stays in files/runs/ as the record.
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ.get("MACH_HOME") or os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

import mach_common as mc  # noqa: E402
import mach_runs as mr  # noqa: E402
import mach_exec as ex  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="mach reject", add_help=False)
    ap.add_argument("id")
    ap.add_argument("reason", nargs="*")
    a = ap.parse_args()
    cfg = mc.load_config_or_warn()
    try:
        run = mr.find_run(a.id, cfg)
    except ValueError as exc:
        mc.die(str(exc))
    if run is None:
        mc.die("no run matches %r (see: mach status)" % a.id)
    reason = " ".join(a.reason).strip() or "rejected"
    ex.reject_run(run, reason)
    print("run %s: cancelled (%s)" % (run.id, reason))
    return 0


if __name__ == "__main__":
    sys.exit(main())
